context Context
sets
  PKT
  TYPE

constants
  safetyThreshold
  BROADCAST
  ND
  Dests
  initialSrcAddr
  finalDestAddr
  type
  DATA
  CONTROL
  CTL_VAL

axioms
  @cM1_axm0_8 safetyThreshold ∈ ℤ
  @cM1_axm0_1 ND ⊆ ℕ
  @cM1_axm0_2 finite(ND)
  @cM1_axm0_3 Dests ⊆ ND
  @cM1_axm0_6 finite(PKT)
  @cM1_axm0_7 initialSrcAddr ∈ PKT → ND
  @cM1_axm0_10 finalDestAddr ∈ PKT → ND {BROADCAST}
  @cM2_axm2_1 DATA ∈ TYPE
  @cM2_axm2_2 CONTROL ⊆ TYPE
  @cM2_axm2_3 partition(TYPE, CONTROL, {DATA})
  @cM2_axm2_4 type ∈ PKT → TYPE
  @cM2_axm2_5 CTL_VAL = 0
  @cM1_axm0_9 BROADCAST = -1

end
