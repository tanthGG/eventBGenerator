MACHINE uM3
REFINES uM2
SEES cM3

VARIABLES
  pktFwdr
  pktData
  createdPkts
  waitingBuff
  sentDown
  sentUp
  ctlNeighbours
  destBuff
  recvBuff
  clrRecvBuffFlg

EVENTS
  Initialisation
    extends
    begin
      skip
    end

Event creatingDataPacket ≙
refines creatingPkt
then
  skip
end

Event creatingControlPacket ≙
refines creatingPkt
then
  skip
end

Event start_tx ≙
extends start_tx
then
  skip
end

Event send_down ≙
extends send_down
then
  skip
end

Event send_up ≙
extends send_up
then
  skip
end

Event receive ≙
extends receive
then
  skip
end

Event clear_recvdBuff ≙
extends clear_recvdBuff
then
  skip
end

Event fwdr_receive_pkt ≙
extends fwdr_receive_pkt
then
  skip
end

Event dest_recv_pkt ≙
extends dest_recv_pkt
then
  skip
end

Event finish_tx_pkt ≙
extends finish_tx_pkt
then
  skip
end

end
