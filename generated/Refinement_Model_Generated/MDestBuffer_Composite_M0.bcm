MACHINE MDestBuffer_Composite_M0
SEES MDestBuffer_Composite_C0

VARIABLES
  pktFwdr
  pktData
  createdPkts
  waitingBuff
  sentDown
  sentUp
  destBuff
  recvBuff
  clrRecvBuffFlg
  ctlNeighbours

INVARIANTS
  @inv01 pktFwdr ∈ PKT ⇸ ND
  @inv02 pktData ∈ PKT ⇸ ℤ
  @inv03 createdPkts ⊆ PKT
  @inv04 waitingBuff ∈ ND ↔ PKT
  @inv05 sentDown ∈ ND ↔ PKT
  @inv06 sentUp ∈ ND ↔ PKT
  @inv07 destBuff ∈ Dests ↔ PKT
  @inv08 recvBuff ∈ ND ↔ PKT
  @inv09 clrRecvBuffFlg ∈ PKT ↔ ND
  @inv10 ctlNeighbours ∈ PKT ↔ ND

EVENTS
  event INITIALISATION
    then
      @int01 destBuff ≔ ∅
      @int02 waitingBuff ≔ ∅
      @int03 pktFwdr ≔ ∅
      @int04 pktData ≔ ∅
      @int05 createdPkts ≔ ∅
      @int06 recvBuff ≔ ∅
      @int07 clrRecvBuffFlg ≔ ∅
      @int08 sentUp ≔ ∅
      @int09 sentDown ≔ ∅
      @int10 ctlNeighbours ≔ ∅
  end

  event start_tx
    any x pkt
    where
      @g01 x ∈ ND
      @g02 pkt ∈ PKT
      @g03 x ↦ pkt ∉ sentDown
      @g04 x ↦ pkt ∈ waitingBuff
      @g05 pkt ∈ dom(pktFwdr)
    then
      @a01 sentDown ≔ sentDown ∪ {x ↦ pkt}
      @a02 waitingBuff ≔ waitingBuff \ {x ↦ pkt}
      @a03 pktFwdr ≔ pktFwdr <+ {pkt ↦ x}
  end

  event send_down
    any x pkt
    where
      @g01 x ∈ ND
      @g02 pkt ∈ PKT
      @g03 x ↦ pkt ∈ sentDown
  end

  event send_up
    any x pkt nbrs
    where
      @g01 nbrs ∈ {n ∣ n ∈ ℙ(ND)}
      @g02 x ∈ ND
      @g03 pkt ∈ PKT
      @g04 nbrs ≠ ∅
      @g05 pkt ∉ dom(ctlNeighbours)
      @g06 x ↦ pkt ∉ sentUp
      @g07 x ↦ pkt ∈ sentDown
    then
      @a01 ctlNeighbours ≔ ctlNeighbours ∪ ({pkt} × nbrs)
      @a02 sentDown ≔ sentDown \ {x ↦ pkt}
      @a03 sentUp ≔ sentUp ∪ {x ↦ pkt}
  end

  event receive
    any x pkt
    where
      @g01 x ∈ ND
      @g02 pkt ∈ PKT
      @g03 x ↦ pkt ∉ recvBuff
      @g04 x ↦ pkt ∉ sentUp
      @g05 x ↦ pkt ∈ sentDown
      @g06 pkt ↦ x ∈ ctlNeighbours
    then
      @a01 recvBuff ≔ recvBuff ∪ {x ↦ pkt}
      @a02 ctlNeighbours ≔ ctlNeighbours \ {pkt ↦ x}
  end

  event fwdr_receive_pkt
    any x pkt
    where
      @g01 x ∈ ND
      @g02 pkt ∈ PKT
      @g03 x ↦ pkt ∈ recvBuff
      @g04 x ↦ pkt ∉ clrRecvBuffFlg
      @g05 x ∉ Dests
      @g06 x ∈ ND \ Dests
      @g07 x ↦ pkt ∉ waitingBuff
    then
      @a01 clrRecvBuffFlg ≔ clrRecvBuffFlg ∪ {x ↦ pkt}
      @a02 waitingBuff ≔ waitingBuff ∪ {x ↦ pkt}
  end

  event dest_recv_pkt
    any nb pkt
    where
      @g01 nb ∈ ND
      @g02 pkt ∈ PKT
      @g03 nb ↦ pkt ∈ recvBuff
      @g04 nb ∈ Dests
      @g05 nb ↦ pkt ∉ clrRecvBuffFlg
      @g06 nb ↦ pkt ∉ destBuff
    then
      @a01 clrRecvBuffFlg ≔ clrRecvBuffFlg ∪ {nb ↦ pkt}
      @a02 destBuff ≔ destBuff ∪ {nb ↦ pkt}
  end

  event finish_tx_pkt
    any x pkt
    where
      @g01 x ∈ ND
      @g02 pkt ∈ PKT
      @g03 {pkt} ◁ ctlNeighbours = ∅
      @g04 pkt ∈ ran(sentUp)
      @g05 pkt ∉ ran(sentDown)
      @g06 x ∈ dom(sentUp)
      @g07 x ↦ pkt ∈ sentUp
      @g08 pkt ∈ ran(waitingBuff)
    then
      @a01 sentUp ≔ sentUp \ {x ↦ pkt}
  end

  event final_tx_pkt
    any pkt
    where
      @g01 pkt ∈ PKT
      @g02 {pkt} ◁ ctlNeighbours = ∅
      @g03 pkt ∈ ran(sentUp)
      @g04 pkt ∉ ran(sentDown)
      @g05 pkt ∉ ran(waitingBuff)
    then
      @a01 sentUp ≔ sentUp ⩥ {pkt}
  end

  event remove_destBuff
    any nb pkt
    where
      @g01 nb ∈ ND
      @g02 pkt ∈ PKT
      @g03 nb ∈ Dests
      @g04 nb ↦ pkt ∈ destBuff
    then
      @a01 destBuff ≔ destBuff \ {x ↦ pkt}
  end

  event is_In_Range_destBuff
    any pkt
    where
      @g01 pkt ∈ PKT
      @g02 pkt ∈ ran(destBuff)
  end

  event isNot_In_Range_destBuff
    any pkt
    where
      @g01 pkt ∈ PKT
      @g02 pkt ∉ ran(destBuff)
  end

  event creatingPkt
    any x des pkt data
    where
      @g01 x ∈ ND \ Dests
      @g02 pkt ∈ PKT
      @g03 data ∈ ℤ
      @g04 x = initialSrc(pkt)
      @g05 des = ran({pkt} ◁ finalDest)
      @g06 pkt ∉ dom(pktFwdr)
      @g07 pkt ∉ dom(pktData)
    then
      @a01 createdPkts ≔ createdPkts ∪ {pkt}
      @a02 pktFwdr ≔ pktFwdr ∪ {pkt ↦ x}
      @a03 pktData ≔ pktData ∪ {pkt ↦ data}
  end

  event clear_recvdBuff
    any x pkt
    where
      @g01 x ∈ ND
      @g02 pkt ∈ PKT
      @g03 x ↦ pkt ∈ recvBuff
      @g04 x ↦ pkt ∈ clrRecvBuffFlg
    then
      @a01 recvBuff ≔ recvBuff \ {x ↦ pkt}
  end

end
