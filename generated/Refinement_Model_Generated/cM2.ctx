context cM2
sets
  PKT
  TYPE

constants
  ND
  Dests
  initialSrcAddr
  finalDest
  initialSrc
  type
  DATA

axioms
  @ax01 ND ⊆ ℕ
  @ax02 finite(ND)
  @ax03 Dests ⊆ ND
  @ax04 finite(PKT)
  @ax05 initialSrcAddr ∈ PKT → ND
  @ax06 finalDest ∈ ℙ(PKT × ℤ)
  @ax07 initialSrc ∈ PKT → ND
  @ax08 ND ⊆ ℕ ∧ finite(ND)
  @ax09 DATA ∈ TYPE
  @ax10 type ∈ PKT → TYPE

end
